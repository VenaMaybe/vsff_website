# Copy to .env for local use. app.py and Flask CLI load it; process variables win.
SECRET_KEY=replace-with-a-random-persistent-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
PDF_REVIEW_ENV=development
PDF_REVIEW_SERVER_NAME=127.0.0.1:5000
PDF_REVIEW_SCHEME=http
PDF_REVIEW_COOKIE_SECURE=0
PDF_REVIEW_PROXY_HOPS=0
# Optional: absolute private runtime directory; default is ./data beside app.py.
# PDF_REVIEW_DATA_DIR=C:/private/pdf-review-dev
# Optional explicit SQLite file; defaults to DATA_DIR/pdf_review.sqlite3.
# PDF_REVIEW_DATABASE=C:/private/pdf-review-dev/pdf_review.sqlite3
PDF_REVIEW_HOST=127.0.0.1
PDF_REVIEW_PORT=5000

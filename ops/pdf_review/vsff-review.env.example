# Install as /etc/vsff-review.env, root:root 0600; edit actual values privately.
# systemd EnvironmentFile syntax: no 'export', shell commands or substitutions.
PDF_REVIEW_ENV=production
PDF_REVIEW_DATA_DIR=/var/lib/vsff-review
SECRET_KEY=REPLACE_WITH_A_RANDOM_PERSISTENT_SECRET_AT_LEAST_32_CHARACTERS
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
PDF_REVIEW_SERVER_NAME=review.venasff.com
PDF_REVIEW_SCHEME=https
# The application compares the literal string "1". Do not use "true".
PDF_REVIEW_COOKIE_SECURE=1
PDF_REVIEW_PROXY_HOPS=1
PDF_REVIEW_HOST=127.0.0.1
PDF_REVIEW_PORT=8002
# No PDF_REVIEW_DATABASE override: use DATA_DIR/pdf_review.sqlite3.
# Do not add GUNICORN_CMD_ARGS or a multi-worker/preload override.

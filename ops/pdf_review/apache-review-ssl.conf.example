# Install only AFTER the separate review certificate exists; see runbook phase 7.
<VirtualHost *:443>
    ServerName review.venasff.com
    SSLEngine On
    SSLCertificateFile /etc/letsencrypt/live/review.venasff.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/review.venasff.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf

    ProxyRequests Off
    ProxyPreserveHost On
    # Overwrite rather than append client/Cloudflare-supplied scheme information.
    RequestHeader unset X-Forwarded-Proto
    RequestHeader set X-Forwarded-Proto "https"

    # WebSocket upgrades go first; ordinary Socket.IO polling uses HTTP below.
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?socket\.io/(.*)$ ws://127.0.0.1:8002/socket.io/$1 [P,L]
    ProxyPass / http://127.0.0.1:8002/ connectiontimeout=5 timeout=120
    ProxyPassReverse / http://127.0.0.1:8002/

    # No Alias/DocumentRoot for private runtime data, no cache of private content.
    CustomLog /dev/null common
    ErrorLog ${APACHE_LOG_DIR}/vsff-review-error.log
    LogLevel warn
</VirtualHost>

# This replaces the bootstrap HTTP vhost after HTTPS acceptance.
<VirtualHost *:80>
    ServerName review.venasff.com
    DocumentRoot /var/www/vsff-review-acme
    <Directory /var/www/vsff-review-acme>
        Options None
        AllowOverride None
        Require all granted
    </Directory>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://review.venasff.com%{REQUEST_URI} [R=301,L,NE]
    CustomLog /dev/null common
    ErrorLog ${APACHE_LOG_DIR}/vsff-review-error.log
</VirtualHost>
